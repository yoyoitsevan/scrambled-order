{
  "name": "scrambled-order-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "iOS and Android app shells (Capacitor) for Scrambled Order. They bundle the same web client from the repo root.",
  "scripts": {
    "build": "node scripts/copy-web.js",
    "sync": "node scripts/copy-web.js && cap sync",
    "android:apk": "node scripts/copy-web.js && cap sync android && cd android && ./gradlew assembleDebug",
    "assets": "capacitor-assets generate --iconBackgroundColor '#3a20c4' --iconBackgroundColorDark '#3a20c4' --splashBackgroundColor '#3a20c4' --splashBackgroundColorDark '#3a20c4'"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/splash-screen": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3"
  }
}
