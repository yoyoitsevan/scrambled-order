{
  "appId": "com.yoyoitsevan.scrambledorder",
  "appName": "Scrambled Order",
  "webDir": "www",
  "backgroundColor": "#3a20c4",
  "android": { "allowMixedContent": false },
  "ios": { "contentInset": "never", "scrollEnabled": false },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#3a20c4",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": false,
      "splashImmersive": false
    },
    "Keyboard": { "resize": "native", "style": "DARK", "resizeOnFullScreen": true },
    "SystemBars": { "insetsHandling": "css", "style": "DARK", "initialViewportFitValueHint": "cover" }
  }
}
